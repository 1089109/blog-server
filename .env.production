# ============================================================
# 生产环境配置（PM2 NODE_ENV=production 时自动加载）
# ============================================================

NODE_ENV=production
PORT=8010

# ── MySQL（API 与 MySQL 在同一台云服务器）──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=blog
DB_USER=root
DB_PASSWORD=Huang520..

# 生产已有完整库，建议关闭自动建表
DB_AUTO_SYNC=true

# ── 安全 ──
JWT_SECRET=blogServer

# 前台访问域名（须与浏览器地址一致，含协议，无末尾斜杠）
CORS_ORIGIN=https://www.huangcy.com
WEB_HOST=https://www.huangcy.com

# ── 阿里云 OSS ──
OSS_REGION=oss-cn-guangzhou
OSS_ACCESS_KEY_ID=xxxx
OSS_ACCESS_KEY_SECRET=xxxx
OSS_BUCKET=huangcy-blog
OSS_CDN_URL=xxx

# ── 阿里云短信 ──
ALIYUN_ACCESS_KEY_ID=xxx
ALIYUN_ACCESS_KEY_SECRET=xx
ALIYUN_SMS_SIGN_NAME=一个亿科技
ALIYUN_SMS_TEMPLATE_CODE=xx
