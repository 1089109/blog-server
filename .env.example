# ============================================================
# 本地开发配置模板（可提交 Git）
# 首次使用：cp .env.example .env  再填入真实值
# 注意：.env 含密钥，已在 .gitignore 中，勿提交 Git
# ============================================================

NODE_ENV=development
PORT=8010

# ── MySQL ──
# 本地 MySQL：127.0.0.1 + root
# 连远程云库（Navicat 那台）：填云服务器 IP + blog 用户
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=blog_test
DB_USER=root
DB_PASSWORD=你的密码

# 空库首次启动可 true，自动建表；已有完整库设 false
DB_AUTO_SYNC=true

# ── 安全 ──
JWT_SECRET=blogServer

# 本地前台地址
CORS_ORIGIN=http://localhost:8011

# ── 阿里云 OSS（可选，未配置则走 server/files/）──
OSS_REGION=oss-cn-guangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_CDN_URL=

# ── 阿里云短信（可选）──
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
