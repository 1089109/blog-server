NODE_ENV=development
PORT=8010

# 与 blog-server/src/utils/db.ts 开发环境一致（库名可单独改）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=blog
DB_USER=root
DB_PASSWORD=huang520

# 启动时自动创建缺失的表（默认 true；已有完整库可设 false）
DB_AUTO_SYNC=true

JWT_SECRET=blogServer
CORS_ORIGIN=http://localhost:8011

# 阿里云 OSS（可选，未配置则使用本地 files 目录）
OSS_REGION=oss-cn-guangzhou
# 阿里云 OSS 配置
OSS_ACCESS_KEY_ID=
# 阿里云 OSS 密钥
OSS_ACCESS_KEY_SECRET=
# 阿里云 OSS 桶名
OSS_BUCKET=
# 阿里云 OSS CDN 域名（可选）
OSS_CDN_URL=

# 阿里云短信（可选）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
